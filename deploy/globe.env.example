# God's Eye View — production environment (row 13, plan §15).
# GENERATED by `node scripts/hosting/env-template.mjs`; edit that script, not this file.
# Install as /etc/gods-eye-view/globe.env, owner root:globe, mode 0640.
# Never commit real values. Keys are entered on the VPS over ssh, never in chat.

# ── Hosting (row 13). Required in production.
# Fail closed: every request is refused unless Access is fully configured.
GEV_REQUIRE_ACCESS=1
# Cloudflare Zero Trust team name or <team>.cloudflareaccess.com.
GEV_ACCESS_TEAM=
# Audience (AUD) tag of the "Commodities" Access application.
GEV_ACCESS_AUD=
# Hostnames the server answers for, comma-separated.
GEV_ALLOWED_HOSTS=commodities.optaimum.com
# Adds the product strip to the globe page at build time.
GEV_NAV_STRIP=1
# Random secret shared with the console; `openssl rand -hex 32`.
GEV_PROXY_KEY=
# The Oil Oracle console the globe proxies.
GEV_CONSOLE_URL=http://127.0.0.1:8011
# Set to 0 to switch the console proxy off.
GEV_CONSOLE_PROXY=
# Switches off the sources docs/LICENCES.md marks OFF, at build and run time. The deploy refuses to build without it.
GEV_LICENCE_PROFILE=hosted
# Comma-separated licencePolicy.js ids whose licence or permission is on file (recorded in docs/LICENCES.md).
GEV_LICENCE_ON_FILE=

# ── Keys. Browser-baked keys reach every signed-in browser: lock them down.
# BROWSER-BAKED at build. HTTP-referrer-lock to https://commodities.optaimum.com/*; Map Tiles + Geocoding only.
GOOGLE_MAPS_API_KEY=
# Server-only Google key. Lock to the VPS IP; Places + Street View Static.
GOOGLE_MAPS_SERVER_API_KEY=
# BROWSER-BAKED at build. Scope to this site; set a usage alert.
CESIUM_ION_TOKEN=
# Voice and HUD summaries. Set a monthly budget cap.
OPENAI_API_KEY=
# Live vessels (row 2).
AISSTREAM_API_KEY=
# NASA FIRMS fires.
FIRMS_MAP_KEY=
# Traffic tiles.
TOMTOM_API_KEY=
# Transport for London cameras.
TFL_APP_KEY=
# Launch Library 2.
LL2_API_TOKEN=
# anon | oauth | basic.
OPENSKY_AUTH_MODE=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ── Cost caps for signed-in users (invitees have founder parity, H5).
# Requests per minute to OpenAI through the server.
GEV_RATELIMIT_OPENAI_PER_MIN=
# Requests per minute to Google through the server.
GEV_RATELIMIT_GOOGLE_PER_MIN=
# TomTom tiles per day.
TOMTOM_DAILY_TILE_BUDGET=

# ── Reserved for milestone 4 (event hub).
# Localhost-only publish listener; never tunnelled.
GEV_EVENTS_PUBLISH_PORT=8021

# ── Optional tuning. Defaults are fine; uncomment to override.
# AISSTREAM_BOUNDING_BOXES=
# AISSTREAM_MESSAGE_TYPES=
# AISSTREAM_SILENCE_TIMEOUT_MS=
# AISSTREAM_URL=
# CCTV_AUSTIN_MAX_SOURCES=
# CCTV_AUSTIN_ROWS_URL=
# CCTV_CALGARY_MAX_SOURCES=
# CCTV_CALGARY_ROWS_URL=
# CCTV_CALTRANS_DISTRICTS=
# CCTV_CALTRANS_MAX_SOURCES=
# CCTV_DRIVEBC_MAX_SOURCES=
# CCTV_DRIVEBC_THIRD_PARTY=
# CCTV_FINTRAFFIC_MAX_SOURCES=
# CCTV_FORCE_AUSTIN=
# CCTV_GROUND_HEIGHTS_FILE=
# CCTV_MAX_SOURCES=
# CCTV_NSW_MAX_SOURCES=
# CCTV_ONTARIO_MAX_SOURCES=
# CCTV_PREFER_AUSTIN=
# CCTV_SOURCES_FILE=
# CCTV_SOURCES_JSON=
# CCTV_TALLINN_MAX_SOURCES=
# CCTV_TALLINN_SOURCES_FILE=
# CCTV_TARKTEE_MAX_SOURCES=
# CCTV_TFL_MAX_SOURCES=
# CCTV_TXDOT_DISTRICTS=
# CCTV_TXDOT_MAX_SOURCES=
# CCTV_WARENDORF_SOURCES_FILE=
# GOOGLE_NEWS_RSS_ENABLED=
# OPENAI_HUD_SUMMARY_MODEL=
# OPENAI_REALTIME_CONTEXT_RETENTION=
# OPENAI_REALTIME_CONTEXT_TOKENS=
# OPENAI_REALTIME_MODEL=
# OPENAI_REALTIME_MODEL_MINI=
# OPENAI_REALTIME_REASONING_EFFORT=
# OPENAI_REALTIME_VOICE=
# OPENSKY_ENABLED=
